# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Server-only Mapbox Search Box token used for live hospital and pharmacy data.
MAPBOX_SEARCH_TOKEN=your-mapbox-search-token-here

# Development only: show deterministic personalized-plan data without calling OpenAI.
PERSONALIZED_PLAN_MOCK=False
